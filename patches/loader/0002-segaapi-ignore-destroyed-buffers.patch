 #define DEBUG_LEVEL -1
 
+// Registry of live buffers: some games keep using a buffer handle after SEGAAPI_DestroyBuffer (harmless on the
+// real hardware). Here that would destroy or touch a freed FAudio voice, and the mixer thread later calls into
+// freed memory. Calls on handles that are not live are logged once and ignored.
+#define LIVE_BUFFERS 8192
+static void *liveBuffers[LIVE_BUFFERS];
+static pthread_mutex_t liveBuffersMutex = PTHREAD_MUTEX_INITIALIZER;
+
+static unsigned int liveSlot(void *handle)
+{
+    return ((unsigned int)(size_t)handle >> 4) % LIVE_BUFFERS;
+}
+
+static void liveAdd(void *handle)
+{
+    pthread_mutex_lock(&liveBuffersMutex);
+    for (unsigned int i = liveSlot(handle), n = 0; n < LIVE_BUFFERS; i = (i + 1) % LIVE_BUFFERS, n++)
+    {
+        if (liveBuffers[i] == NULL || liveBuffers[i] == (void *)1)
+        {
+            liveBuffers[i] = handle;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&liveBuffersMutex);
+}
+
+static int liveFind(void *handle)
+{
+    for (unsigned int i = liveSlot(handle), n = 0; n < LIVE_BUFFERS && liveBuffers[i] != NULL;
+         i = (i + 1) % LIVE_BUFFERS, n++)
+    {
+        if (liveBuffers[i] == handle)
+            return (int)i;
+    }
+    return -1;
+}
+
+static int liveCheck(void *handle, const char *func)
+{
+    pthread_mutex_lock(&liveBuffersMutex);
+    int found = liveFind(handle) >= 0;
+    pthread_mutex_unlock(&liveBuffersMutex);
+    if (!found)
+    {
+        static void *lastDead;
+        if (handle != lastDead)
+            fprintf(stderr, "libsegaapi: %s on a destroyed or unknown buffer %p, ignored\n", func, handle);
+        lastDead = handle;
+    }
+    return found;
+}
+
+// Removes the handle; returns 0 if it was not live (double destroy)
+static int liveRemove(void *handle)
+{
+    pthread_mutex_lock(&liveBuffersMutex);
+    int i = liveFind(handle);
+    if (i >= 0)
+        liveBuffers[i] = (void *)1; // tombstone keeps probe chains intact
+    pthread_mutex_unlock(&liveBuffersMutex);
+    return i >= 0;
+}
+
+#define LIVE_CHECK(handle, returnValue)                                                                                \
+    if (!liveCheck(handle, __func__))                                                                                  \
+        return returnValue;
+
